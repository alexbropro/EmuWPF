<Application x:Class="EmuWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EmuWPF"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrText2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover: lighten background -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrText1}"/>
                            </Trigger>

                            <!-- Selected: cyan highlight (Tag="1" means selected) -->
                            <Trigger Property="Tag" Value="1">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrCyanDim}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrCyanDim}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrCyan}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorderMid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrBorderMid}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrCyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── SecondaryBtn ── -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrText2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrBorderMid}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrText1}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DarkTextBox ── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrSurface}"/>
            <!-- TextBoxes use standard text colour now (BrText1) instead of grey -->
            <Setter Property="Foreground" Value="{DynamicResource BrText1}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrCyan}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrBorderMid}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrText1}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrText2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrCyanDim}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrCyan}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme brushes (used via DynamicResource throughout the app) -->
        <!-- Main accent ("Standard") tuned to a slightly less neon, more standard cyan -->
        <SolidColorBrush x:Key="BrCyan"      Color="#00AEEF"/>
        <SolidColorBrush x:Key="BrCyanDim"   Color="#2600AEEF"/>
        <SolidColorBrush x:Key="BrBorder"    Color="#1F00AEEF"/>
        <SolidColorBrush x:Key="BrBorderMid" Color="#4000AEEF"/>
        <!-- Surface/deep/void adjusted to darker blacks per request -->
        <SolidColorBrush x:Key="BrRaised"    Color="#141422"/>
        <SolidColorBrush x:Key="BrSurface"   Color="#060609"/> <!-- darker surface -->
        <SolidColorBrush x:Key="BrDeep"      Color="#030304"/> <!-- darker deep (near-black) -->
        <SolidColorBrush x:Key="BrVoid"      Color="#000000"/> <!-- full black -->
        <SolidColorBrush x:Key="BrText1"     Color="#E8E8F0"/>
        <SolidColorBrush x:Key="BrText2"     Color="#9090B0"/>
        <SolidColorBrush x:Key="BrText3"     Color="#555570"/>
        <SolidColorBrush x:Key="BrHover"     Color="#1A1A2E"/>
    </Application.Resources>
</Application>
