                               Foreground="#00F0FF"
                               FontSize="14"
                               FontWeight="SemiBold"
                            TextWrapping="Wrap"/>
                            <TextBlock Text="• Library, EmuCores and Updates pages added"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,6,0,2"
                              TextWrapping="Wrap"/>
                            <TextBlock Text="• NES, SNES, N64, GameCube and Wii supported"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,2"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• N64 scaling fixed"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>

                            <TextBlock Text="• WII Input still an issue. Will fix next update. NES scaling broken. Will Fix next Update. SNES and NES and GC are working perfectly"
   Foreground="#9090B0"
   FontSize="12"
   Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid x:Name="PageNowPlaying" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar (named so code-behind can measure its height) -->
                    <Border x:Name="NowPlayingHeader" Grid.Row="0"
            Background="#0A0A12"
            BorderBrush="#1F00F0FF"
            BorderThickness="0,0,0,1"
            Padding="16,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="▶  " Foreground="#00F0FF" FontSize="14"/>
                                <TextBlock x:Name="NowPlayingTitle"
                           Text="Game Title"
                           Foreground="#E8E8F0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Click game to refocus"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="10,5"
                        Margin="0,0,10,0"
                        IsHitTestVisible="False"
                        Opacity="0.5"/>
                                <Button Content="✕  Stop"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="12,5"
                        Click="BtnStopEmu_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Game area — clicking here refocuses -->
                    <Border x:Name="EmuHost" Grid.Row="1"
            Background="Black"
            MouseLeftButtonDown="EmuHost_MouseDown"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

                </Grid>
                <!-- SETTINGS PAGE -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
            Background="#0A0A12"
            BorderBrush="#1F00F0FF"
            BorderThickness="0,0,0,1"
            Padding="16,12">
                        <Grid>
                            <TextBlock Text="Settings"
                       Foreground="#E8E8F0"
                       FontSize="18"
                       FontWeight="SemiBold"/>
                            <Button Content="💾  Save Settings"
                    Style="{StaticResource PrimaryBtn}"
                    HorizontalAlignment="Right"
                    Padding="14,6"
                    Click="BtnSaveSettings_Click"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,16">

                            <!-- ── THEME ── -->
                            <TextBlock Text="THEME"
                       Foreground="#00F0FF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
                            <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,24">
                                <StackPanel>

                                    <!-- Accent colour -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Accent Colour"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Main highlight colour"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="TxtAccentColour"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="120" Margin="0,0,10,0"/>
                                            <Border x:Name="AccentPreview"
                                    Width="32" Height="32"
                                    CornerRadius="4"
                                    Background="#00F0FF"/>
                                            <Button Content="Apply"
                                    Style="{StaticResource SecondaryBtn}"
                                    Padding="10,5" Margin="10,0,0,0"
                                    Click="BtnApplyAccent_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Background colour -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Background Colour"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Main window background"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="TxtBgColour"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="120" Margin="0,0,10,0"/>
                                            <Border x:Name="BgPreview"
                                    Width="32" Height="32"
                                    CornerRadius="4"
                                    Background="#0A0A12"/>
                                            <Button Content="Apply"
                                    Style="{StaticResource SecondaryBtn}"
                                    Padding="10,5" Margin="10,0,0,0"
                                    Click="BtnApplyBg_Click"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── AUDIO ── -->
                            <TextBlock Text="AUDIO"
                       Foreground="#00F0FF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
                            <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,24">
                                <StackPanel>

                                    <!-- Volume -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Volume"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Master volume (0–100)"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                            <Slider x:Name="SliderVolume"
                                    Minimum="0" Maximum="100" Value="100"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    Foreground="#00F0FF"
                                    ValueChanged="SliderVolume_Changed"/>
                                            <TextBlock x:Name="TxtVolume"
                                       Text="100"
                                       Foreground="#E8E8F0"
                                       FontSize="13"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mute -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Mute"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Silence all audio"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkMute"
                                  Grid.Column="1"
                                  Foreground="#E8E8F0"
                                  VerticalAlignment="Center"
                                  Content="Mute audio"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── DISPLAY ── -->
                            <TextBlock Text="DISPLAY"
                       Foreground="#00F0FF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
                            <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,24">
                                <StackPanel>

                                    <!-- Resolution -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Resolution"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Emulator render resolution"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbResolution"
                                  Grid.Column="1"
                                  Width="160" HorizontalAlignment="Left"
                                  Background="#141422" Foreground="#E8E8F0"
                                  BorderBrush="#1F00F0FF"
                                  FontSize="13" Padding="8,5">
                                            <ComboBoxItem Content="640x480"/>
                                            <ComboBoxItem Content="800x600"/>
                                            <ComboBoxItem Content="1280x720"/>
                                            <ComboBoxItem Content="1920x1080"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Fullscreen -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Fullscreen"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Launch games in fullscreen"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkFullscreen"
                                  Grid.Column="1"
                                  Foreground="#E8E8F0"
                                  VerticalAlignment="Center"
                                  Content="Enable fullscreen"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Border>
    </Grid>
</Window>
