<Window x:Class="EmuWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmuWPF" 
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Closing="Window_Closing"
        Background="{DynamicResource BrDeep}"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        WindowState="Maximized">
    <Window.Resources>
       
    </Window.Resources>
    <Grid>
    
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="StripeBg"
           IsHitTestVisible="False"
           Grid.ColumnSpan="10"
           Grid.RowSpan="10"/>

        <Border Grid.Column="0"
            Background="{DynamicResource BrSidebar}"
            BorderBrush="{DynamicResource BrBorder}"
            BorderThickness="0,0,1,0">

            <DockPanel Margin="10" LastChildFill="True">

            <!-- Quit: always red, ignores the accent colour. Declared first so it sits at the very bottom -->
            <Button x:Name="BQuit"
                DockPanel.Dock="Bottom"
                Content="✕  Quit"
                ToolTip="Close ProjNimu (stops any running game)"
                Click="BQuit_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#26FF4444"/>
                        <Setter Property="Foreground" Value="#FF4444"/>
                        <Setter Property="BorderBrush" Value="#66FF4444"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4DFF4444"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4444"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Dev toggle: switches NES/SNES between the V1 and V2 launch code -->
            <Button x:Name="BLaunchMode"
                DockPanel.Dock="Bottom"
                Content="Launch Mode: V2"
                ToolTip="Switch NES and SNES between the old (V1) and new (V2) launch code. Applies to the next game you start."
                Style="{StaticResource NavButton}"
                Tag="0"
                Margin="0,0,0,6"
                Click="BLaunchMode_Click"/>

            <StackPanel>
                <TextBlock Text="ProjNimu"
                       Foreground="{DynamicResource BrCyan}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,10,0,20"
                       HorizontalAlignment="Center"/>

                <Button x:Name="BHome"
                Content="Home"
                Style="{StaticResource NavButton}"
                Tag="1"
                Click="NavBtn_Click"/>

                <Button x:Name="BLibrary"
                Content="Library"
                Style="{StaticResource NavButton}"
                Tag="0"
                Click="NavBtn_Click"/>

                <Button x:Name="BEmuCores"
                Content="EmuCores"
                Style="{StaticResource NavButton}"
                Tag="0"
                Click="NavBtn_Click"/>

                <Button x:Name="BUpdates"
                Content="Updates"
                Style="{StaticResource NavButton}"
                Tag="0"
                Click="NavBtn_Click"/>
                <Button x:Name="BSettings"
                Content="⚙ Settings"
                Style="{StaticResource NavButton}"
                Tag="0"
                Click="NavBtn_Click"/>

                <Button x:Name="BNP"
                Content="▶ Now Playing"
                Style="{StaticResource NavButton}"
                Tag="0"
                Visibility="Collapsed"
                Click="NavBtn_Click"/>
            </StackPanel>
            </DockPanel>
        </Border>


        <Border Grid.Column="1"
            Background="{DynamicResource BrSurface}">

            <Grid>
                
                <!-- HOME PAGE -->
                <StackPanel x:Name="PageHome"
                    Visibility="Visible"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <TextBlock Text="EmuHub"
                       Foreground="{DynamicResource BrCyan}"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
                    <TextBlock Text="Your retro game library"
                       Foreground="{DynamicResource BrText3}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
                </StackPanel>

                <!-- LIBRARY PAGE -->
                <StackPanel x:Name="PageLibrary" Visibility="Collapsed">

                    <!-- Header bar (matches sidebar) -->
                    <Border Background="{DynamicResource BrDeep}"
            BorderBrush="{DynamicResource BrBorder}"
            BorderThickness="0,0,0,1"
            Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- System filter -->
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <Button x:Name="BtnFilterAll"
                        Content="All"
                        Style="{StaticResource NavButton}"
                        Tag="1"
                        Margin="0,3,6,3"
                        Click="FilterBtn_Click"/>

                                <Button x:Name="BtnFilterNES"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,3,6,3"
                        Click="FilterBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#E74C3C" Margin="0,0,6,0"/>
                                        <TextBlock Text="NES" Foreground="{DynamicResource BrText1}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnFilterSNES"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,3,6,3"
                        Click="FilterBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#9B59B6" Margin="0,0,6,0"/>
                                        <TextBlock Text="SNES" Foreground="{DynamicResource BrText1}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnFilterN64"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,3,6,3"
                        Click="FilterBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#3498DB" Margin="0,0,6,0"/>
                                        <TextBlock Text="Nintendo 64" Foreground="{DynamicResource BrText1}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnFilterGCN"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,3,6,3"
                        Click="FilterBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#1ABC9C" Margin="0,0,6,0"/>
                                        <TextBlock Text="GameCube" Foreground="{DynamicResource BrText1}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnFilterWii"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,3,6,3"
                        Click="FilterBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#E67E22" Margin="0,0,6,0"/>
                                        <TextBlock Text="Wii" Foreground="{DynamicResource BrText1}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Add Game -->
                            <Button Grid.Column="1"
                    Content="+ Add Game"
                    Style="{StaticResource PrimaryBtn}"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Padding="14,7"
                    Click="BtnAddGame_Click"/>
                        </Grid>
                    </Border>

                    <!-- Game grid -->
                    <WrapPanel x:Name="GameGrid" Margin="20,24,20,0"/>

                    <!-- No-games placeholder -->
                    <TextBlock x:Name="NoGamesText"
               Text="No games yet"
               Foreground="{DynamicResource BrText3}"
               FontSize="14"
               Margin="20,40,0,0"
               HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- EMUCORES PAGE — System folder view -->
                <Grid x:Name="PageEmucores" Visibility="Collapsed">

                    <!-- System folder list-->
                    <StackPanel x:Name="EmucoresFolderView" Visibility="Visible" Margin="24">
                        <TextBlock Text="EmuCores"
                           Foreground="{DynamicResource BrText1}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                        <TextBlock Text="Select a system to configure its emulation core"
                           Foreground="{DynamicResource BrText3}"
                           FontSize="13"
                           Margin="0,0,0,20"/>

                        <WrapPanel>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="NES">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#E74C3C"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="NES" Foreground="{DynamicResource BrText1}"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="SNES">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#9B59B6"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="SNES" Foreground="{DynamicResource BrText1}"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="N64">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#3498DB"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Nintendo 64" Foreground="{DynamicResource BrText1}"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="GameCube">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#1ABC9C"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="GameCube" Foreground="{DynamicResource BrText1}"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="Wii">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#E67E22"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Wii" Foreground="{DynamicResource BrText1}"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Core settings view -->
                    <StackPanel x:Name="EmucoreSettingsView"
                        Visibility="Collapsed"
                        Margin="24">

                        <!-- Back button + title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="← Back"
                            Style="{StaticResource SecondaryBtn}"
                            Padding="10,5"
                            Margin="0,0,16,0"
                            Click="EmucoreBack_Click"/>
                            <TextBlock x:Name="EmucoreSystemTitle"
                               Text="N64 — EmuCore Settings"
                               Foreground="{DynamicResource BrText1}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tab buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="TabBtnCore"
                Content="Core"
                Style="{StaticResource NavButton}"
                Tag="1"
                Padding="16,8"
                Margin="0,0,6,0"
                Click="EmucoreTab_Click"/>
                            <Button x:Name="TabBtnControls"
                Content="Controls"
                Style="{StaticResource NavButton}"
                Tag="0"
                Padding="16,8"
                Click="EmucoreTab_Click"/>
                        </StackPanel>

                        <!-- ── CORE TAB ── -->
                        <StackPanel x:Name="TabCore" Visibility="Visible">

                            <TextBlock Text="Select Core"
                   Foreground="{DynamicResource BrText2}"
                   FontSize="12"
                   Margin="0,0,0,6"/>
                            <ComboBox x:Name="CoreDropdown"
                  Width="300"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,24"
                  Background="{DynamicResource BrSurface}"
                  Foreground="{DynamicResource BrText1}"
                  BorderBrush="{DynamicResource BrBorder}"
                  FontSize="13"
                  Padding="10,6"/>

                            <TextBlock Text="Add Custom Core"
                   Foreground="{DynamicResource BrText2}"
                   FontSize="12"
                   Margin="0,0,0,6"/>
                            <TextBlock Text="Browse to a custom emulator .exe to add it as a core option"
                   Foreground="{DynamicResource BrText3}"
                   FontSize="11"
                   Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="CustomCorePath"
                     Width="320"
                     Style="{StaticResource DarkTextBox}"
                     IsReadOnly="True"
                     Margin="0,0,8,0"/>
                                <Button Content="Browse…"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="BrowseCore_Click"/>
                                <Button Content="Add Core"
                    Style="{StaticResource PrimaryBtn}"
                    Padding="12,6"
                    Click="AddCore_Click"/>
                            </StackPanel>

                        </StackPanel>
                        <!-- ── CONTROLS TAB ── -->
                        <ScrollViewer x:Name="TabControls"
              Visibility="Collapsed"
              VerticalScrollBarVisibility="Auto"
              MaxHeight="500">
                            <StackPanel>

                                <!-- Header row -->
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Key Bindings"
                       Foreground="{DynamicResource BrText2}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                                        <Button Content="Reset Defaults"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="10,5"
                        Margin="0,0,8,0"
                        Click="BtnResetControls_Click"/>
                                        <Button Content="💾 Save Controls"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="10,5"
                        Click="BtnSaveControls_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Click a box then press any key to bind it"
                   Foreground="{DynamicResource BrText3}"
                   FontSize="11"
                   Margin="0,0,0,16"/>

                                <Border Background="{DynamicResource BrDeep}"
                BorderBrush="{DynamicResource BrBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="PS5 Controller"
                               Foreground="{DynamicResource BrText1}" FontSize="13"/>
                                            <TextBlock Text="Connect via USB or Bluetooth before launching"
                               Foreground="{DynamicResource BrText3}" FontSize="11"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ToggleController"
                              Grid.Column="1"
                              Content="Use Controller"
                              Checked="ToggleController_Changed"
                              Unchecked="ToggleController_Changed"
                              Padding="12,6"
                              FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- N64 Controls -->
                                <Grid x:Name="N64ControlsPanel" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT COLUMN -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="ANALOGUE STICK" Foreground="{DynamicResource BrCyan}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Up" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStickUp" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Down" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStickDown" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Left" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStickLeft" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Right" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStickRight" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>

                                        <TextBlock Text="BUTTONS" Foreground="{DynamicResource BrCyan}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="A" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindA" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="B" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindB" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Z" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindZ" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Start" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStart" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="L" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindL" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="R" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindR" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- RIGHT COLUMN -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="C BUTTONS" Foreground="{DynamicResource BrCyan}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="C Up" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindCUp" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="C Down" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindCDown" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="C Left" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindCLeft" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="C Right" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindCRight" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>

                                        <TextBlock Text="D-PAD" Foreground="{DynamicResource BrCyan}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="D Up" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindDUp" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="D Down" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
