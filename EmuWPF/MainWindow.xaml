                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Z" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="NunchuckBindZ" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Stick Up" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="NunchuckBindUp" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Stick Down" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="NunchuckBindDown" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Stick Left" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="NunchuckBindLeft" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Stick Right" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="NunchuckBindRight" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="+" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="WiiBindPlus" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="-" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="WiiBindMinus" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Home" Foreground="{DynamicResource BrText2}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="WiiBindHome" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <!-- UPDATES PAGE -->
                <ScrollViewer x:Name="PageUpdates" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="Updates"
                       Foreground="#E8E8F0"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
                    <TextBlock Text="Developer update log"
                       Foreground="#555570"
                       FontSize="13"
                       Margin="0,0,0,20"/>

                    <!-- v1.02 -->
                    <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    MaxWidth="1000"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="v1.02"
                               Foreground="{DynamicResource BrCyan}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Better Wii optimisation"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,6,0,2"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Faster catch on NES and SNES"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,2"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Implemented 2 different ways of catching the SNES and NES windows"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,2"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Added more Wii inputs"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,2"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Other fixes"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- v1.01 -->
                    <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    MaxWidth="1000"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="v1.01"
                               Foreground="{DynamicResource BrCyan}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Quick lil bug fixes related to SNES and NES input"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,6,0,2"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Fixed the lag on Dolphin"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,2"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Improved emulator loading times"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- v1.0 -->
                    <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    MaxWidth="1000"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="v1.0 — Main Release"
                               Foreground="{DynamicResource BrCyan}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• Finished implementing all the game emulators and polished up any major bugs or issues"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- v0.0.1 -->
                    <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    MaxWidth="1000"
                    HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="v0.0.1 — First Build"
                               Foreground="{DynamicResource BrCyan}"
                               FontSize="14"
                               FontWeight="SemiBold"
                            TextWrapping="Wrap"/>
                            <TextBlock Text="• Library, EmuCores and Updates pages added"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,6,0,2"
                              TextWrapping="Wrap"/>
                            <TextBlock Text="• NES, SNES, N64, GameCube and Wii supported"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,2"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="• N64 scaling fixed"
                               Foreground="#9090B0"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>

                            <TextBlock Text="• WII Input still an issue. Will fix next update. NES scaling broken. Will Fix next Update. SNES and NES and GC are working perfectly"
   Foreground="#9090B0"
   FontSize="12"
   Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
                <Grid x:Name="PageNowPlaying" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Border x:Name="NowPlayingHeader" Grid.Row="0"
            Background="#0A0A12"
            BorderBrush="#1F00F0FF"
            BorderThickness="0,0,0,1"
            Padding="16,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                
                                <TextBlock Text="▶  " Foreground="{DynamicResource BrCyan}" FontSize="14"/>
                                <TextBlock x:Name="NowPlayingTitle"
                           Text="Game Title"
                           Foreground="#E8E8F0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Click game to refocus"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="10,5"
                        Margin="0,0,10,0"
                        IsHitTestVisible="False"
                        Opacity="0.5"/>
                                <Button Content="✕  Stop"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="12,5"
                        Click="BtnStopEmu_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Game area -->
                    <Border x:Name="EmuHost" Grid.Row="1"
            Background="Black"
            MouseLeftButtonDown="EmuHost_MouseDown"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            SizeChanged="EmuHost_SizeChanged"/>

                    

                </Grid>
                <!-- SETTINGS PAGE -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
            Background="#0A0A12"
            BorderBrush="#1F00F0FF"
            BorderThickness="0,0,0,1"
            Padding="16,12">
                        <Grid>
                            <TextBlock Text="Settings"
                       Foreground="{DynamicResource BrCyan}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="↺  Reset Settings"
                        Style="{StaticResource SecondaryBtn}"
                        ToolTip="Restore theme, audio, display and launch mode to their defaults"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Click="BtnResetSettings_Click"/>
                                <Button Content="💾  Save Settings"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="14,6"
                        Click="BtnSaveSettings_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,16">

                            <!-- ── THEME ── -->
                            <TextBlock Text="THEME"
           Foreground="{DynamicResource BrCyan}"
           FontSize="11" FontWeight="SemiBold"
           Margin="0,0,0,10"/>
                            <Border Background="#141422"
        BorderBrush="#1F00F0FF"
        BorderThickness="1" CornerRadius="6"
        Padding="16" Margin="0,0,0,24">
                                <StackPanel>

                                    <!-- Accent colour -->
                                    <TextBlock Text="Accent Colour"
                   Foreground="{DynamicResource BrText1}"
                   FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Main highlight colour used throughout the app"
                   Foreground="{DynamicResource BrText3}"
                   FontSize="11" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,20">
                                        <Button x:Name="BtnAccentRed"
                    Content="Red" Width="80" Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryBtn}"
                    Tag="#FF4444"
                    Click="BtnAccentColour_Click">
                                            <Button.BorderBrush>
                                                <SolidColorBrush Color="#FF4444"/>
                                            </Button.BorderBrush>
                                        </Button>
                                        <Button x:Name="BtnAccentGreen"
                    Content="Green" Width="80" Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryBtn}"
                    Tag="#00FF88"
                    Click="BtnAccentColour_Click">
                                            <Button.BorderBrush>
                                                <SolidColorBrush Color="#00FF88"/>
                                            </Button.BorderBrush>
                                        </Button>
                                        <Button x:Name="BtnAccentBlue"
                    Content="Blue" Width="80" Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryBtn}"
                    Tag="#00F0FF"
                    Click="BtnAccentColour_Click">
                                            <Button.BorderBrush>
                                                <SolidColorBrush Color="#00F0FF"/>
                                            </Button.BorderBrush>
                                        </Button>
                                        <Button x:Name="BtnAccentPurple"
                    Content="Purple" Width="80" Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryBtn}"
                    Tag="#8B5CF6"
                    Click="BtnAccentColour_Click">
                                            <Button.BorderBrush>
                                                <SolidColorBrush Color="#8B5CF6"/>
                                            </Button.BorderBrush>
                                        </Button>
                                        <Button x:Name="BtnAccentYellow"
                    Content="Yellow" Width="80" Height="32"
                    Style="{StaticResource SecondaryBtn}"
                    Tag="#FFD700"
                    Click="BtnAccentColour_Click">
                                            <Button.BorderBrush>
                                                <SolidColorBrush Color="#FFD700"/>
                                            </Button.BorderBrush>
                                        </Button>
                                    </WrapPanel>

                                    <!-- Background colour -->
                                    <TextBlock Text="Background Colour"
                   Foreground="{DynamicResource BrText1}"
                   FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Main window and sidebar background"
                   Foreground="{DynamicResource BrText3}"
                   FontSize="11" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="BtnBgTrueBlack"
        Content="True Black" Width="90" Height="32"
        Margin="0,0,8,0"
        Style="{StaticResource SecondaryBtn}"
        Tag="#000000"
        Click="BtnBgColour_Click"/>
                                        <Button x:Name="BtnBgBlack"
        Content="Black" Width="80" Height="32"
        Margin="0,0,8,0"
        Style="{StaticResource SecondaryBtn}"
        Tag="#0A0A12"
        Click="BtnBgColour_Click"/>
                                        <Button x:Name="BtnBgGrey"
        Content="Grey" Width="80" Height="32"
        Margin="0,0,8,0"
        Style="{StaticResource SecondaryBtn}"
        Tag="#1E1E2E"
        Click="BtnBgColour_Click"/>
                                        <Button x:Name="BtnBgWhite"
        Content="White" Width="80" Height="32"
        Style="{StaticResource SecondaryBtn}"
        Tag="#F0F0F0"
        Click="BtnBgColour_Click"/>
                                    </WrapPanel>

                                    <!-- Sidebar opacity -->
                                    <TextBlock Text="Sidebar Opacity"
                   Foreground="{DynamicResource BrText1}"
                   FontSize="13" Margin="0,20,0,4"/>
                                    <TextBlock Text="How see-through the sidebar is. 100% is solid"
                   Foreground="{DynamicResource BrText3}"
                   FontSize="11" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="SliderSidebarOpacity"
                    Minimum="0" Maximum="100" Value="100"
                    Width="200"
                    SmallChange="1" LargeChange="10"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    VerticalAlignment="Center"
                    ValueChanged="SliderSidebarOpacity_Changed"/>
                                        <TextBlock x:Name="TxtSidebarOpacity"
                    Text="100%"
                    Foreground="{DynamicResource BrText1}"
                    FontSize="13"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- ── AUDIO ── -->
                            <TextBlock Text="AUDIO"
                       Foreground="{DynamicResource BrCyan}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
                            <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,24">
                                <StackPanel>

                                    <!-- Volume -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Volume"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Master volume (0–100)"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                            <Slider x:Name="SliderVolume"
                                    Minimum="0" Maximum="100" Value="100"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    Foreground="#00F0FF"
                                    ValueChanged="SliderVolume_Changed"/>
                                            <TextBlock x:Name="TxtVolume"
                                       Text="100"
                                       Foreground="#E8E8F0"
                                       FontSize="13"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mute -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Mute"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Silence all audio"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkMute"
                                  Grid.Column="1"
                                  Foreground="#E8E8F0"
                                  VerticalAlignment="Center"
                                  Content="Mute audio"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── DISPLAY ── -->
                            <TextBlock Text="DISPLAY"
                       Foreground="{DynamicResource BrCyan}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
                            <Border Background="#141422"
                    BorderBrush="#1F00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,24">
                                <StackPanel>

                                    <!-- Resolution -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Resolution"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Emulator render resolution"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbResolution"
                                  Grid.Column="1"
                                  Width="160" HorizontalAlignment="Left"
                                  Background="#141422" Foreground="#E8E8F0"
                                  BorderBrush="#1F00F0FF"
                                  FontSize="13" Padding="8,5">
                                            <ComboBoxItem Content="640x480"/>
                                            <ComboBoxItem Content="800x600"/>
                                            <ComboBoxItem Content="1280x720"/>
                                            <ComboBoxItem Content="1920x1080"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Fullscreen -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Fullscreen"
                                       Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Launch games in fullscreen"
                                       Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkFullscreen"
                                  Grid.Column="1"
                                  Foreground="#E8E8F0"
                                  VerticalAlignment="Center"
                                  Content="Enable fullscreen"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Border>
    </Grid>
</Window>
