<Window x:Class="EmuWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmuWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Closing="Window_Closing"
        Background="#0A0A12"
        WindowState="Maximized">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Border Grid.Column="0"
            Background="#0F0F1A"
            BorderBrush="#1F00F0FF"
            BorderThickness="0,0,1,0">

            <StackPanel Margin="10">
                <TextBlock Text="ProjNimu"
                       Foreground="#00F0FF"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,10,0,20"
                       HorizontalAlignment="Center"/>

                <Button x:Name="BHome"
                Content="Home"
                Style="{StaticResource NavButton}"
                Tag="1"
                Click="NavBtn_Click"/>

                <Button x:Name="BLibrary"
                Content="Library"
                Style="{StaticResource NavButton}"
                Tag="0"
                Click="NavBtn_Click"/>

                <Button x:Name="BEmuCores"
                Content="EmuCores"
                Style="{StaticResource NavButton}"
                Tag="0"
                Click="NavBtn_Click"/>

                <Button x:Name="BUpdates"
                Content="Updates"
                Style="{StaticResource NavButton}"
                Tag="0"
                Click="NavBtn_Click"/>
                <Button x:Name="BSettings"
                Content="⚙ Settings"
                Style="{StaticResource NavButton}"
                Tag="0"
                Click="NavBtn_Click"/>

                <Button x:Name="BNP"
                Content="▶ Now Playing"
                Style="{StaticResource NavButton}"
                Tag="0"
                Visibility="Collapsed"
                Click="NavBtn_Click"/>
            </StackPanel>
        </Border>


        <Border Grid.Column="1"
            Background="#0F0F1A">

            <Grid>

                <!-- HOME PAGE -->
                <StackPanel x:Name="PageHome"
                    Visibility="Visible"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <TextBlock Text="EmuHub"
                       Foreground="#00F0FF"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
                    <TextBlock Text="Your retro game library"
                       Foreground="#555570"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
                </StackPanel>

                <!-- LIBRARY PAGE -->
                <StackPanel x:Name="PageLibrary" Visibility="Collapsed">


                    <!-- System filter-->
                    <WrapPanel Margin="20,16,20,8">
                        <Button x:Name="BtnFilterAll"
                        Content="All"
                        Style="{StaticResource NavButton}"
                        Tag="1"
                        Margin="0,0,6,6"
                        Click="FilterBtn_Click"/>
                        <Button x:Name="BtnFilterNES"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,0,6,6"
                        Click="FilterBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#E74C3C" Margin="0,0,6,0"/>
                                <TextBlock Text="NES"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnFilterSNES"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,0,6,6"
                        Click="FilterBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#9B59B6" Margin="0,0,6,0"/>
                                <TextBlock Text="SNES"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnFilterN64"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,0,6,6"
                        Click="FilterBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#3498DB" Margin="0,0,6,0"/>
                                <TextBlock Text="Nintendo 64"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnFilterGCN"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,0,6,6"
                        Click="FilterBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#1ABC9C" Margin="0,0,6,0"/>
                                <TextBlock Text="GameCube"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnFilterWii"
                        Style="{StaticResource NavButton}"
                        Tag="0"
                        Margin="0,0,6,6"
                        Click="FilterBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#E67E22" Margin="0,0,6,0"/>
                                <TextBlock Text="Wii"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Button Content="+ Add Game"
            Style="{StaticResource PrimaryBtn}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Padding="14,7"
            Click="BtnAddGame_Click"/>

                    <!-- Divider -->
                    <Separator Background="#1F00F0FF" Margin="20,0"/>

                    <!-- Game grid -->
                    <WrapPanel x:Name="GameGrid" Margin="20,24,20,0" />

                    <!-- No-games placeholder -->
                    <TextBlock x:Name="NoGamesText"
                       Text="No games yet"
                       Foreground="#555570"
                       FontSize="14"
                       Margin="20,40,0,0"
                       HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- EMUCORES PAGE — System folder view -->
                <Grid x:Name="PageEmucores" Visibility="Collapsed">

                    <!-- System folder list-->
                    <StackPanel x:Name="EmucoresFolderView" Visibility="Visible" Margin="24">
                        <TextBlock Text="EmuCores"
                           Foreground="#E8E8F0"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                        <TextBlock Text="Select a system to configure its emulation core"
                           Foreground="#555570"
                           FontSize="13"
                           Margin="0,0,0,20"/>

                        <WrapPanel>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="NES">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#E74C3C"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="NES" Foreground="#E8E8F0"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="SNES">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#9B59B6"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="SNES" Foreground="#E8E8F0"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="N64">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#3498DB"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Nintendo 64" Foreground="#E8E8F0"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="GameCube">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#1ABC9C"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="GameCube" Foreground="#E8E8F0"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryBtn}"
                            Width="140" Height="100" Margin="0,0,12,12"
                            Click="EmuFolder_Click" Tag="Wii">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Fill="#E67E22"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Wii" Foreground="#E8E8F0"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Core settings view -->
                    <StackPanel x:Name="EmucoreSettingsView"
                        Visibility="Collapsed"
                        Margin="24">

                        <!-- Back button + title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="← Back"
                            Style="{StaticResource SecondaryBtn}"
                            Padding="10,5"
                            Margin="0,0,16,0"
                            Click="EmucoreBack_Click"/>
                            <TextBlock x:Name="EmucoreSystemTitle"
                               Text="N64 — EmuCore Settings"
                               Foreground="#E8E8F0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tab buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="TabBtnCore"
                Content="Core"
                Style="{StaticResource NavButton}"
                Tag="1"
                Padding="16,8"
                Margin="0,0,6,0"
                Click="EmucoreTab_Click"/>
                            <Button x:Name="TabBtnControls"
                Content="Controls"
                Style="{StaticResource NavButton}"
                Tag="0"
                Padding="16,8"
                Click="EmucoreTab_Click"/>
                        </StackPanel>

                        <!-- ── CORE TAB ── -->
                        <StackPanel x:Name="TabCore" Visibility="Visible">

                            <TextBlock Text="Select Core"
                   Foreground="#9090B0"
                   FontSize="12"
                   Margin="0,0,0,6"/>
                            <ComboBox x:Name="CoreDropdown"
                  Width="300"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,24"
                  Background="#141422"
                  Foreground="#E8E8F0"
                  BorderBrush="#1F00F0FF"
                  FontSize="13"
                  Padding="10,6"/>

                            <TextBlock Text="Add Custom Core"
                   Foreground="#9090B0"
                   FontSize="12"
                   Margin="0,0,0,6"/>
                            <TextBlock Text="Browse to a custom emulator .exe to add it as a core option"
                   Foreground="#555570"
                   FontSize="11"
                   Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="CustomCorePath"
                     Width="320"
                     Style="{StaticResource DarkTextBox}"
                     IsReadOnly="True"
                     Margin="0,0,8,0"/>
                                <Button Content="Browse…"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="BrowseCore_Click"/>
                                <Button Content="Add Core"
                    Style="{StaticResource PrimaryBtn}"
                    Padding="12,6"
                    Click="AddCore_Click"/>
                            </StackPanel>

                        </StackPanel>
                        <!-- ── CONTROLS TAB ── -->
                        <ScrollViewer x:Name="TabControls"
              Visibility="Collapsed"
              VerticalScrollBarVisibility="Auto"
              MaxHeight="500">
                            <StackPanel>

                                <!-- Header row -->
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Key Bindings"
                       Foreground="#9090B0"
                       FontSize="12"
                       VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                                        <Button Content="Reset Defaults"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="10,5"
                        Margin="0,0,8,0"
                        Click="BtnResetControls_Click"/>
                                        <Button Content="💾 Save Controls"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="10,5"
                        Click="BtnSaveControls_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Click a box then press any key to bind it"
                   Foreground="#555570"
                   FontSize="11"
                   Margin="0,0,0,16"/>

                                <Border Background="#141422"
                BorderBrush="#1F00F0FF"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="PS5 Controller"
                               Foreground="#E8E8F0" FontSize="13"/>
                                            <TextBlock Text="Connect via USB or Bluetooth before launching"
                               Foreground="#555570" FontSize="11"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ToggleController"
                              Grid.Column="1"
                              Content="Use Controller"
                              Checked="ToggleController_Changed"
                              Unchecked="ToggleController_Changed"
                              Padding="12,6"
                              FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- N64 Controls -->
                                <Grid x:Name="N64ControlsPanel" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT COLUMN -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="ANALOGUE STICK" Foreground="#00F0FF" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Up" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStickUp" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Down" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStickDown" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Left" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStickLeft" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Right" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStickRight" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>

                                        <TextBlock Text="BUTTONS" Foreground="#00F0FF" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="A" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindA" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="B" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindB" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Z" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindZ" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Start" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindStart" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="L" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindL" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="R" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindR" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- RIGHT COLUMN -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="C BUTTONS" Foreground="#00F0FF" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="C Up" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindCUp" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="C Down" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindCDown" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="C Left" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindCLeft" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="C Right" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindCRight" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>

                                        <TextBlock Text="D-PAD" Foreground="#00F0FF" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="D Up" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindDUp" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="D Down" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindDDown" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="D Left" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindDLeft" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="D Right" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BindDRight" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- NES Controls -->
                                <StackPanel x:Name="NESControlsPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Up" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="NESBindUp" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Down" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="NESBindDown" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Left" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="NESBindLeft" Grid.Column="1" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="BindBox_KeyDown" GotFocus="BindBox_GotFocus" LostFocus="BindBox_LostFocus"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Right" Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
